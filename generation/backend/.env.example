# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://generation_user:changeme@localhost:5432/generation_db

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required: a unique non-placeholder secret of at least 32 characters. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Object storage (S3-compatible) — filled in when a provider is connected.
# Until then, the storage adapter falls back to local disk under /uploads
# for local development only. Do NOT use local disk in production.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
